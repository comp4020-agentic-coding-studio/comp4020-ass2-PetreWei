---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import LangSwitch from "../../components/LangSwitch.astro";
import heroImage from "../../assets/images/hero-home.avif";
import { courseMeta } from "../../course-config";
import { siteConfig, zhLinks } from "../../site-config";

// This page is written from the course's ideas rather than translated from
// src/pages/index.astro: the English is deliberately colloquial, and that
// register reads as flippant in Chinese, so the prose here is plain 书面语
// and diverges sentence by sentence while stating the same argument.
//
// Pilot translation: only the home page and nav are translated so far, so
// the tags below are a display-only Chinese gloss of courseMeta.tags rather
// than a second source of truth — the English tags in course-config.ts
// remain the ones spec/course-promises.test.ts checks.
const tagLabels: Record<string, string> = {
  retries: "重试",
  backoff: "退避",
  outages: "服务中断",
};
---

<ContentLayout
  title={`${courseMeta.code}：稍后重试`}
  description="本课程围绕同一个决定展开：系统出错之后，是否应当重试，以及如何重试。十二周对应十二种具体情况，从时断时续的 HTTP 调用，到同一笔款项被重复扣除的支付流程。课程要回答的问题是：重试在什么情况下确实有效，又在什么情况下会使问题进一步恶化。"
  heroImage={heroImage}
  heroImageAlt="同一只手反复按下同一个按钮，五次印痕依次错位，偏移逐次增大；米色纸面，金黑双色孔版印刷"
  {...siteConfig}
  links={zhLinks}
>
  <LangSwitch href="/" label="View in English" />

  <ul class="course-tags" aria-label="课程标签">
    {courseMeta.tags.map((tag) => <li>{tagLabels[tag] ?? tag}</li>)}
  </ul>

  <p class="thesis">
    答案通常是肯定的，而风险恰恰在于此。重试看上去是负责任的做法，几乎每一次也都能奏效，但它从来都不是没有代价的。本课程讨论的每一种方案都是一次权衡：在换取某些保障的同时，必然付出另一些成本。课程要训练的只有一项能力：在付出代价之前，先把代价说清楚。
  </p>

  <h2>十二周，十二种情况</h2>
  <p>
    课程安排的不是十二个主题，而是同一个问题在十二种情况下的十二次提问。每一种情况都足够具体，可以直接复现：一次读取操作超时；同一笔款项被扣除两次；一万个客户端在同一秒内同时重连；凌晨三点，两个人分别发出了同一笔付款，而两次操作之间没有任何代码加以拦截。
  </p>
  <p>
    每一周的结构相同：先给出方案，再核算代价。退避（backoff）为濒临过载的下游服务争取了缓冲时间，代价是自身请求的延迟；熔断（circuit
    breaker）主动放弃了原本可能获得的可用性；超时截止（deadline）会丢弃即将成功的请求。到第十二周，你应当已经无法接受一条不说明代价的重试策略。这就是本课程的全部内容。
  </p>

  <h2>适合什么样的学生</h2>
  <p>
    本课程面向三年级学生：写过需要经过网络通信的代码，并且已经为此付出过一次代价。你应当能够读懂一份陌生的代码库，并在其中做出少量修改。课程不要求分布式系统的理论基础，也不假定你有生产环境的运维经验。
  </p>
  <p>
    本学期的大部分时间，你都在有意制造故障，并决定如何应对。学期结束时，你会得到三项成果：一份审计报告；一条重试策略，你需要当面为它辩护，而对方受命找出它的漏洞；以及一篇书面论证，说明在某些情况下根本不应重试。
  </p>

  <h2>继续了解</h2>
  <CardGrid columns={2}>
    <Card title="实验" href="/sessions/">
      <p>十二种情况按周次排列，以及各自需要付出的代价。（该页面暂为英文）</p>
    </Card>
    <Card title="考核" href="/assessments/">
      <p>一份审计、一条需要当面辩护的策略，以及一篇论证文章。各项分值与截止时间。（该页面暂为英文）</p>
    </Card>
    <Card title="教学团队" href="/people/">
      <p>课程的授课人员、联系时应准备的材料，以及答疑时间。（该页面暂为英文）</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .thesis {
    font-size: 1.15rem;
    line-height: 1.55;
    margin-block: 0 2.5rem;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid var(--at-accent);
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
