---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import LangSwitch from "../../components/LangSwitch.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`The twelve-week teaching schedule: what happens in each ${sessionLabels.singular.toLowerCase()}, what to prepare, and what leaves the room.`}
  {...siteConfig}
>
  <LangSwitch href="/zh/" label="中文" />

  <p>
    Each lab is the hands-on work behind that week's lecture: build the
    failure, make it happen on purpose, then fix it and say what the fix does
    to the requests that were working already. <code>related:</code> connects
    a lab to the lecture that sets it up and the assessment it feeds.
  </p>
  <SessionsGrid />
</ContentLayout>
